rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    function isTeacher() {
      return isAuthenticated() && 
        (request.auth.token.role == 'teacher' || 
         exists(/databases/$(database)/documents/teachers/$(request.auth.uid)));
    }

    function isDistrictAdmin() {
      return isAuthenticated() && 
        (request.auth.token.role == 'district_admin' || 
         exists(/databases/$(database)/documents/districtAdmins/$(request.auth.uid)));
    }
    
    // 1. Teachers collection
    match /teachers/{teacherId} {
      allow read: if isAuthenticated();
      allow write: if isOwner(teacherId) || isDistrictAdmin();
    }
    
    // 2. Students collection (Students never create accounts; managed by teachers/admins)
    match /students/{studentId} {
      allow read: if isAuthenticated();
      allow create, update: if isTeacher() || isDistrictAdmin() || isOwner(studentId);
      allow delete: if isTeacher() || isDistrictAdmin();
    }
    
    // 3. Classrooms (Teachers only access their classrooms; District admins access all)
    match /classrooms/{classroomId} {
      allow read: if isAuthenticated();
      allow create: if isTeacher() || isDistrictAdmin();
      allow update, delete: if isDistrictAdmin() || 
        (isTeacher() && (resource == null || resource.data.teacherId == request.auth.uid));
    }
    
    // 4. District Analytics & Schools (District admins access district-wide analytics)
    match /districtAnalytics/{districtId} {
      allow read, write: if isDistrictAdmin();
    }

    match /schools/{schoolId} {
      allow read: if isAuthenticated();
      allow write: if isDistrictAdmin();
    }
    
    match /districts/{districtId} {
      allow read: if isAuthenticated();
      allow write: if isDistrictAdmin();
    }
    
    // 5. Attendance records (Teachers manage classroom attendance, Admins inspect)
    match /attendance/{attendanceId} {
      allow read: if isAuthenticated();
      allow write: if isTeacher() || isDistrictAdmin();
    }
    
    // 6. Student Progress (Students read only their own progress; Teachers & Admins can read & update)
    match /progress/{progressId} {
      allow read: if isDistrictAdmin() || isTeacher() || 
        (isAuthenticated() && (resource == null || resource.data.studentId == request.auth.uid));
      allow write: if isDistrictAdmin() || isTeacher() || 
        (isAuthenticated() && (resource == null || resource.data.studentId == request.auth.uid));
    }

    // 7. Daily Activity Logs
    match /dailyActivity/{activityId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    // 8. Vocabulary Progress (SM-2 Spaced Repetition)
    match /vocabularyProgress/{vocabId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    // 9. Reading Sessions Analytics
    match /readingSessions/{sessionId} {
      allow read, write: if isAuthenticated();
    }

    // 10. Speech & Pronunciation Sessions
    match /speechSessions/{sessionId} {
      allow read, write: if isAuthenticated();
    }

    // 11. Streak History
    match /streakHistory/{streakId} {
      allow read, write: if isAuthenticated();
    }

    // 12. Badges & Leaderboard
    match /badges/{badgeId} {
      allow read, write: if isAuthenticated();
    }

    match /leaderboard/{entryId} {
      allow read, write: if isAuthenticated();
    }

    // 13. Assignments & Homework
    match /assignments/{assignmentId} {
      allow read: if isAuthenticated();
      allow write: if isTeacher() || isDistrictAdmin();
    }
    
    // 14. Worksheets & Worksheet History
    match /worksheets/{worksheetId} {
      allow read: if isAuthenticated();
      allow write: if isTeacher() || isDistrictAdmin();
    }

    match /worksheetHistory/{historyId} {
      allow read, write: if isAuthenticated();
    }
    
    // 15. Stories & Story History
    match /stories/{storyId} {
      allow read: if isAuthenticated();
      allow write: if isTeacher() || isDistrictAdmin();
    }

    match /storyHistory/{historyId} {
      allow read, write: if isAuthenticated();
    }
    
    // 16. Flashcards & Flashcard History
    match /flashcards/{flashcardId} {
      allow read: if isAuthenticated();
      allow write: if isTeacher() || isDistrictAdmin();
    }

    match /flashcardHistory/{historyId} {
      allow read, write: if isAuthenticated();
    }
    
    // 17. Production Quiz Engine (Quizzes, Questions, Attempts, Results, Question Bank, Adaptive Profiles)
    match /quizzes/{quizId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isTeacher() || isDistrictAdmin();
    }

    match /quizQuestions/{questionId} {
      allow read: if isAuthenticated();
      allow write: if isTeacher() || isDistrictAdmin();
    }

    match /quizAttempts/{attemptId} {
      allow read: if isTeacher() || isDistrictAdmin() ||
        (isAuthenticated() && (resource == null || resource.data.studentId == request.auth.uid));
      allow create, update: if isAuthenticated();
      allow delete: if isDistrictAdmin();
    }

    match /quizResults/{resultId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    match /questionBank/{questionId} {
      allow read: if isAuthenticated();
      allow write: if isTeacher() || isDistrictAdmin();
    }

    match /adaptiveProfiles/{profileId} {
      allow read, write: if isAuthenticated();
    }

    match /inProgressAttempts/{attemptId} {
      allow read, write: if isAuthenticated();
    }
    
    // 18. Translations & Voice History
    match /translations/{translationId} {
      allow read, write: if isAuthenticated();
    }
    
    match /voiceHistory/{historyId} {
      allow read, write: if isAuthenticated();
    }

    // 19. Offline Sync Queue
    match /offlineSyncQueue/{queueId} {
      allow read, write: if isAuthenticated();
    }

    // 20. SPRINT 4: Production Curriculum Engine (Public Read, Admin/Teacher Write)
    match /curriculum/{curriculumId} {
      allow read: if true;
      allow write: if isDistrictAdmin();
    }
    match /subjects/{subjectId} {
      allow read: if true;
      allow write: if isDistrictAdmin();
    }
    match /chapters/{chapterId} {
      allow read: if true;
      allow write: if isDistrictAdmin();
    }
    match /lessons/{lessonId} {
      allow read: if true;
      allow write: if isDistrictAdmin();
    }
    match /competencies/{competencyId} {
      allow read: if true;
      allow write: if isDistrictAdmin();
    }
    match /vocabulary/{wordId} {
      allow read: if true;
      allow write: if isDistrictAdmin();
    }
    match /stories/{storyId} {
      allow read: if true;
      allow write: if isDistrictAdmin();
    }
    match /activities/{activityId} {
      allow read: if true;
      allow write: if isDistrictAdmin();
    }
    match /worksheetsTemplates/{worksheetId} {
      allow read: if true;
      allow write: if isDistrictAdmin();
    }
    match /lessonPlans/{templateId} {
      allow read: if true;
      allow write: if isDistrictAdmin() || isTeacher();
    }
    match /flashcardsLibrary/{cardId} {
      allow read: if true;
      allow write: if isDistrictAdmin();
    }
    match /mediaLibrary/{mediaId} {
      allow read: if true;
      allow write: if isDistrictAdmin();
    }
    match /curriculumPacks/{packId} {
      allow read: if true;
      allow write: if isDistrictAdmin();
    }
    match /lessonCompletions/{completionId} {
      allow read, write: if isAuthenticated();
    }
  }
}
